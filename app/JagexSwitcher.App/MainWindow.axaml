<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:JagexSwitcher.App" x:Class="JagexSwitcher.App.MainWindow"
        Title="Jagex Switcher" Icon="/Assets/app.ico" Width="1160" Height="760" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen" ExtendClientAreaToDecorationsHint="True" WindowDecorations="BorderOnly"
        Padding="{Binding $self.OffScreenMargin}">
  <Grid>
    <Grid Name="Workspace" ColumnDefinitions="312,*">
      <!-- Sidebar: brand, search, profiles, secondary actions -->
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="48,Auto,*,Auto" Margin="14,0,14,14">
          <StackPanel Orientation="Horizontal" Spacing="9" Margin="6,2,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/app.ico" Width="18" Height="18" />
            <TextBlock Text="Jagex Switcher" FontSize="12" FontWeight="SemiBold" Classes="quiet" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="14" Margin="0,14,0,12">
            <Grid ColumnDefinitions="*,Auto" Margin="6,0">
              <TextBlock Classes="display" Text="Profiles" FontSize="22" />
              <Border Grid.Column="1" Classes="kbd" Padding="8,3"><TextBlock Name="ProfileCount" Text="0" FontSize="11" /></Border>
            </Grid>
            <TextBox Name="SearchBox" PlaceholderText="Search profiles" TextChanged="SearchChanged" AutomationProperties.Name="Search profiles">
              <TextBox.InnerLeftContent>
                <TextBlock Classes="icon quiet" Text="&#xE721;" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Border Classes="kbd" Margin="0,0,8,0"><TextBlock Text="Ctrl F" /></Border>
              </TextBox.InnerRightContent>
            </TextBox>
          </StackPanel>
          <Grid Grid.Row="2">
            <ListBox Name="ProfileList" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="0" SelectionChanged="SelectionChanged"
                     DoubleTapped="PlayDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved profiles">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ProfileInfo">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{Binding AvatarBrush}">
                      <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse Classes="dot" Classes.ready="{Binding IsReady}" Width="11" Height="11" Stroke="{DynamicResource PanelBrush}" StrokeThickness="2"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="quiet" Classes.danger="{Binding !IsReady}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LastPlayedShort}" FontSize="11" Classes="quiet" VerticalAlignment="Center" Opacity="0.8" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="ListEmpty" Text="No profiles yet." TextWrapping="Wrap" TextAlignment="Center" Classes="quiet" FontSize="13" Margin="12,36" LineHeight="21" />
          </Grid>
          <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0">
            <Button Name="AddButton" HorizontalAlignment="Stretch" Click="OpenAdd" AutomationProperties.Name="Add account" ToolTip.Tip="Add account (Ctrl+N)">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="Add account" /></StackPanel>
            </Button>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Name="TransferButton" Classes="subtle" HorizontalAlignment="Stretch" Click="OpenTransfer" AutomationProperties.Name="Transfer profiles" ToolTip.Tip="Move a profile between PCs">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon quiet" Text="&#xE8AB;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Transfer" FontSize="13" Classes="quiet" /></StackPanel>
              </Button>
              <Button Grid.Column="1" Name="SettingsButton" Classes="subtle" HorizontalAlignment="Stretch" Click="OpenSettings" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="icon quiet" Text="&#xE713;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Settings" FontSize="13" Classes="quiet" /></StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Stage: full-bleed artwork with the selected character and Play on top -->
      <Grid Grid.Column="1" Background="Black" ClipToBounds="True">
        <Border Name="LandscapeImage">
          <Border.Background><ImageBrush Source="/Assets/landscape.png" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top" /></Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#990B0D10" Offset="0" /><GradientStop Color="#000B0D10" Offset="0.2" />
              <GradientStop Color="#1A0B0D10" Offset="0.42" /><GradientStop Color="#D90B0D10" Offset="0.78" /><GradientStop Color="#F70B0D10" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#8C0B0D10" Offset="0" /><GradientStop Color="#000B0D10" Offset="0.6" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Border Name="CaptureBadge" Classes="pill" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,56,0,0"
                ToolTip.Tip="RuneLite is writing session credentials to disk. Capture turns off when a profile is saved or you press Play.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="#E8BE74" VerticalAlignment="Center" />
            <TextBlock Text="CAPTURE ON" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2" Foreground="#E8BE74" />
          </StackPanel>
        </Border>

        <Grid Name="StageContent" Margin="40,0,40,48" VerticalAlignment="Bottom">
          <StackPanel Name="SelectedDetails" IsVisible="False">
            <Border Classes="pill" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Name="StatusDot" Classes="dot onart" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock Name="CredentialText" Classes="onart" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock Name="CharacterName" Classes="display onart" FontSize="46" LetterSpacing="-1" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="32" Margin="2,14,0,0">
              <StackPanel Spacing="6"><TextBlock Text="PROFILE" Classes="eyebrow onartquiet" /><TextBlock Name="SelectedName" Classes="onart" FontSize="13" MaxWidth="220" TextTrimming="CharacterEllipsis" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="LAST PLAYED" Classes="eyebrow onartquiet" /><TextBlock Name="LastPlayedText" Classes="onart" FontSize="13" /></StackPanel>
              <StackPanel Spacing="6"><TextBlock Text="SAVED" Classes="eyebrow onartquiet" /><TextBlock Name="ImportedText" Classes="onart" FontSize="13" /></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,28,0,0">
              <Button Name="PlayButton" Classes="primary play" Height="56" MinWidth="256" Padding="24,0" CornerRadius="14" Click="PlayClicked" AutomationProperties.Name="Play in RuneLite">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="icon" Text="&#xE768;" FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="Play in RuneLite" FontSize="16" VerticalAlignment="Center" />
                  <Border Background="#2E241A0A" CornerRadius="5" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="Enter" FontSize="10" /></Border>
                </StackPanel>
              </Button>
              <Button Name="ReimportButton" Classes="glass" Height="56" Padding="20,0" CornerRadius="14" IsVisible="False" Click="ReimportClicked"
                      ToolTip.Tip="Replace this profile's saved session with the current RuneLite login">
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Re-import" /></StackPanel>
              </Button>
              <Button Name="ManageButton" Classes="glass" Height="56" Padding="20,0" CornerRadius="14" Click="OpenManage" ToolTip.Tip="Rename, re-import or remove (F2)">
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE70F;" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Manage" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Name="WelcomePanel" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="WELCOME" Classes="eyebrow" Foreground="#E8BE74" />
            <TextBlock Text="Make yourself at home." Classes="display onart" FontSize="42" LetterSpacing="-1" Margin="0,12,0,0" />
            <TextBlock Text="Save each character once through Jagex Launcher. After that, pick a profile and you're in the game with a single click."
                       TextWrapping="Wrap" Classes="onartquiet" FontSize="14" LineHeight="23" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,28,0,0">
              <Button Classes="primary play" Height="52" Padding="24,0" CornerRadius="14" Click="OpenAdd">
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="icon" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="Add your first account" FontSize="15" /></StackPanel>
              </Button>
              <Button Classes="glass" Height="52" Padding="20,0" CornerRadius="14" Click="OpenReceive" Content="Receive from another PC" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- Dialogs -->
    <Border Name="DialogOverlay" Background="#A6080A0D" IsVisible="False" Padding="24,56,24,24" KeyboardNavigation.TabNavigation="Cycle" PointerPressed="ScrimPressed">
      <Border Name="DialogCard" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18"
              Width="460" MaxHeight="590" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 32 96 0 #99000000">
        <Grid RowDefinitions="Auto,Auto,*" Margin="26,24,26,26">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="6">
              <TextBlock Name="DialogTitle" Classes="display" FontSize="22" TextWrapping="Wrap" />
              <TextBlock Name="DialogSubtitle" Classes="quiet" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
            </StackPanel>
            <Button Grid.Column="1" Name="DialogClose" Classes="subtle" Width="32" MinHeight="32" Padding="0" Margin="8,-4,-6,0" VerticalAlignment="Top"
                    Click="CloseDialogClicked" AutomationProperties.Name="Close dialog" ToolTip.Tip="Close (Esc)">
              <TextBlock Classes="icon quiet" Text="&#xE8BB;" FontSize="10" />
            </Button>
          </Grid>
          <Border Grid.Row="1" Name="DialogError" Classes="banner" IsVisible="False" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="icon danger" Text="&#xE783;" FontSize="15" Margin="0,2,0,0" />
              <TextBlock Grid.Column="1" Name="DialogErrorText" Classes="danger" TextWrapping="Wrap" FontSize="13" LineHeight="20" AutomationProperties.LiveSetting="Assertive" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-18,-6"><ContentControl Name="DialogContent" Margin="0,0,18,6" /></ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Status toast -->
    <Border Name="Toast" Classes="pill" Background="#F2101317" Padding="16,9" Opacity="0" IsHitTestVisible="False" MaxWidth="560"
            HorizontalAlignment="Center" BoxShadow="0 8 28 0 #66000000">
      <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions></Border.Transitions>
      <TextBlock Name="StatusText" Text="Ready when you are." Classes="onart" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </Border>

    <ProgressBar Name="BusyIndicator" IsVisible="False" IsIndeterminate="True" Height="2" MinHeight="2" VerticalAlignment="Top" CornerRadius="0" Background="Transparent" />

    <!-- Title bar: drag region plus caption buttons over the artwork -->
    <Border Height="48" VerticalAlignment="Top" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
      <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,7,8,0" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Classes="caption" WindowDecorationProperties.ElementRole="MinimizeButton" Click="Minimize" AutomationProperties.Name="Minimize"><TextBlock Classes="icon" Text="&#xE921;" FontSize="10" /></Button>
        <Button Classes="caption" WindowDecorationProperties.ElementRole="MaximizeButton" Click="Maximize" AutomationProperties.Name="Maximize or restore"><TextBlock Classes="icon" Text="&#xE922;" FontSize="10" /></Button>
        <Button Classes="caption close" WindowDecorationProperties.ElementRole="CloseButton" Click="CloseWindow" AutomationProperties.Name="Close"><TextBlock Classes="icon" Text="&#xE8BB;" FontSize="10" /></Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
